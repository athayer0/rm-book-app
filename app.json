{
  "expo": {
    "name": "RM Calendar",
    "slug": "compi",
    "version": "1.0.0",
    "scheme": "compi",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.aaronthayer.compi",
      "supportsTablet": false,
      "infoPlist": {
        "NSContactsUsageDescription": "Allow RM Calendar to access your contacts to import people into your list.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#f5f5f5",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#111111"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1B5E3F"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.150594044412-4nddrri65036mnq6i3bkpp108imdv042"
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "owner": "athayer0",
    "extra": {
      "eas": {
        "projectId": "1c95a4fa-01cf-4919-aa17-d5fcc6917a01"
      }
    }
  }
}
